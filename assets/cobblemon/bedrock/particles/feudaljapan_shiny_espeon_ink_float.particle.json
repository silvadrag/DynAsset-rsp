{
  "format_version": "1.10.0",
  "particle_effect": {
    "components": {
      "minecraft:emitter_lifetime_expression": { "activation_expression": 1 },
      "minecraft:emitter_rate_steady": {
        "max_particles": 100,
        "spawn_rate": 5
      },
      "minecraft:emitter_shape_disc": { "direction": [0, 1, 0], "radius": 2 },
      "minecraft:particle_appearance_billboard": {
        "facing_camera_mode": "rotate_xyz",
        "size": ["0.05+(-0.05*v.particle_age)", "0.05+0.5*v.particle_age"],
        "uv": {
          "texture_height": 16,
          "texture_width": 16,
          "uv": [0, 0],
          "uv_size": [16, 16]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "gradient": {
            "0.0": "#6652828F",
            "0.23": "#FFC1F3FB",
            "0.43": "#FFBDD7C7",
            "0.66": "#FF52828F",
            "0.9": "#36003E32",
            "1.0": "#0D003E32"
          },
          "interpolant": "v.particle_age / v.particle_lifetime"
        }
      },
      "minecraft:particle_initial_speed": 0.5,
      "minecraft:particle_lifetime_expression": { "max_lifetime": 1 },
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [0, 5, 0],
        "linear_drag_coefficient": 5
      }
    },
    "description": {
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particles/ci_ink_float"
      },
      "identifier": "cobblemon:feudaljapan_shiny_espeon_ink_float"
    }
  }
}
