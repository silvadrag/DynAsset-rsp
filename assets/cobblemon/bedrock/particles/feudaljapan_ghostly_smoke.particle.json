{
  "format_version": "1.10.0",
  "particle_effect": {
    "components": {
      "minecraft:emitter_lifetime_expression": { "activation_expression": 1 },
      "minecraft:emitter_rate_steady": {
        "max_particles": 30,
        "spawn_rate": 10
      },
      "minecraft:emitter_shape_disc": {
        "direction": "outwards",
        "offset": [0, 0, 0.15],
        "radius": "0.2 * 1.7",
        "surface_only": true
      },
      "minecraft:particle_appearance_billboard": {
        "facing_camera_mode": "rotate_xyz",
        "size": ["variable.shrink", "variable.shrink"],
        "uv": {
          "flipbook": {
            "base_UV": [0, 0],
            "frames_per_second": 7,
            "max_frame": 6,
            "size_UV": [16, 16],
            "step_UV": [0, 16]
          },
          "texture_height": 96,
          "texture_width": 16
        }
      },
      "minecraft:particle_appearance_lighting": {},
      "minecraft:particle_appearance_tinting": {
        "color": {
          "gradient": { "0.0": "#FF37DAAD", "1.0": "#FF198D75" },
          "interpolant": "v.particle_age / v.particle_lifetime"
        }
      },
      "minecraft:particle_initial_speed": -0.1,
      "minecraft:particle_initial_spin": { "rotation": "math.random(0,360)" },
      "minecraft:particle_lifetime_expression": { "max_lifetime": 0.8 },
      "minecraft:particle_motion_dynamic": {}
    },
    "curves": {
      "variable.shrink": {
        "horizontal_range": "v.particle_lifetime",
        "input": "v.particle_age",
        "nodes": [0, 0.81, 1, 1, 1, 1, 0.98, 0.9],
        "type": "linear"
      }
    },
    "description": {
      "basic_render_parameters": {
        "material": "particles_alpha",
        "texture": "textures/particles/generic/smoke/smoke"
      },
      "identifier": "cobblemon:feudaljapan_ghostly_smoke"
    }
  }
