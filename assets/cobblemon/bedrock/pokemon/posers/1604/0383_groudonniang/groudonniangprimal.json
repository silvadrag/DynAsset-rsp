{
  "portraitScale": 1,
  "portraitTranslation": [-0.3, 3.6, 0],
  "profileScale": 0.3,
  "profileTranslation": [0, 1.3, 1],
  "rootBone": "groudonniangprimal",
  "firstPersonCameraOffset": {
    "seat_1": [0, 0.45, 0],
    "seat_2": [0, 0.45, 0]
  },
  "thirdPersonCameraOffset": {
    "seat_1": [0, 0.4, 0.5],
    "seat_1_reverse": [0, 0.4, 0.5],
    "seat_2": [0, 0.4, 0.5],
    "seat_2_reverse": [0, 0.4, 0.5]
  },
  "thirdPersonCameraOffsetNoViewBobbing": {
    "seat_1": [0, 0.4, 0.5],
    "seat_1_reverse": [0, 0.4, 0.5],
    "seat_2": [0, 0.4, 0.5],
    "seat_2_reverse": [0, 0.4, 0.5]
  },
  "animations": {
    "faint": "q.bedrock_primary('groudonniangprimal', 'faint', q.curve('one'))",
    "cry": "q.bedrock_stateful('groudonniangprimal', 'cry')",
    "recoil": "q.bedrock_stateful('groudonniangprimal', 'recoil')",
    "physical": "q.bedrock_primary('groudonniangprimal', 'physical_attack', q.curve('symmetrical_wide'))",
    "special": "q.bedrock_primary('groudonniangprimal', 'special_attack', q.curve('symmetrical_wide'))",
    "precipiceblades": "q.bedrock_primary('groudonniangprimal', 'precipiceblades',q.curve('symmetrical_wide'))",
    "status": "q.bedrock_primary('groudonniangprimal', 'cry', q.curve('symmetrical_wide'))"
  },
  "poses": {
    "battle-standing": {
      "poseTypes": ["STAND"],
      "isBattle": true,
      "animations": [
       "q.look('head_ai')",
        "q.bedrock('groudonniangprimal', 'battle_idle')"
      ],
      "quirks": [
        "q.bedrock_quirk('groudonniangprimal', 'blink')",
        "q.bedrock_quirk('groudonniangprimal', 'battle_quirk')"
      ],
      "namedAnimations": {
      "cry": "q.bedrock_primary('groudonniangprimal', 'battle_cry', q.curve('symmetrical_wide'))"
      }
    },
    "run": {
        "poseTypes": ["STAND","WALK"],
        "isBattle": false,
        "condition": "!q.in_air && q.is_sprinting",
        "animations": [
          "q.look('head_ai')",
          "q.bedrock('groudonniangprimal', 'ground_run')",
        {
          "condition": "q.is_ridden",
          "animation": "q.bedrock('groudonniangprimal', 'ride_ground_run')"
        }
      ]
    },
     "standing": {
      "poseTypes": ["STAND", "NONE","PORTRAIT", "PROFILE"],
      "isBattle": false,
      "isTouchingWater": false,
      "condition": "!q.in_air",
      "animations": ["q.look('head_ai')","q.bedrock('groudonniangprimal', 'ground_idle')"],
      "quirks": [
        "q.bedrock_quirk('groudonniangprimal', 'blink')",
        "q.bedrock_quirk('groudonniangprimal', 'ground_quirk')",
        "q.bedrock_primary_quirk('groudonniangprimal', 'idle_quirk', 20, 40, 1, q.curve('symmetrical'))"
      ]
      },
      "in-air": {
        "poseTypes": ["STAND", "WALK","NONE"],
        "isBattle": false,
        "condition": "q.in_air && q.is_ridden",
        "animations": ["q.look('head_ai')", "q.bedrock('groudonniangprimal', 'ride_jump')"],
        "transformTicks": 5,
        "transformToTicks": 5
      },
    "walk": {
      "poseTypes": [
        "WALK"
      ],
      "condition": "!q.in_air&& !q.is_sprinting",
      "animations": [
        "q.look('head_ai')",
        "q.bedrock('groudonniangprimal', 'ground_walk')",
        {
          "condition": "q.is_ridden",
          "animation": "q.bedrock('groudonniangprimal', 'ride_ground_run')"
        }
      ]
    }, 
    "float": {
      "poseTypes": ["FLOAT"],
      "animations": [
        "q.bedrock('groudonniangprimal', 'ground_idle')"
      ],
      "quirks": ["q.bedrock_quirk('groudonniangprimal', 'blink')"]
    },
    "swim": {
      "poseTypes": ["SWIM"],
      "animations": [
        "q.bedrock('groudonniangprimal', 'ground_walk')"
      ],
      "quirks": ["q.bedrock_quirk('groudonniangprimal', 'blink')"]
    },
    "sleep": {
      "poseTypes": ["SLEEP"],
      "namedAnimations": {
        "cry": "q.bedrock_stateful('dummy', 'cry')"
      },
      "animations": [
        "q.bedrock('groudonniangprimal', 'sleep')",
        {
          "condition": "q.is_holding_item",
          "animation": "q.bedrock('groudonniangprimal', 'hold_item')"
        }
      ],
      "quirks": [
        "q.bedrock_quirk('groudonniangprimal', 'sleep_quirk')"
      ]
    }
   }
  }
