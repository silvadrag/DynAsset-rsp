{
  "firstPersonCameraOffset": { "seat_1": [0, 0.45, 0] },
  "portraitScale": 1.76,
  "portraitTranslation": [-0.7, 1.56, 0],
  "animations": {
    "cry": "q.bedrock_stateful('miraidon_snowfated', 'cry')",
    "electrodrift": "q.bedrock_primary('miraidon_snowfated', 'electrodrift', q.curve('symmetrical_wide'))"
  },
  "poses": {
    "battle-standing": {
      "animations": [
        "q.look('head', 0.4, 0.25, 5, -5, 10, -10)",
        "q.bedrock('miraidon_snowfated', 'battle_idle')"
      ],
      "isBattle": true,
      "isTouchingWater": false,
      "poseTypes": ["STAND"],
      "quirks": ["q.bedrock_quirk('miraidon_snowfated', 'blink')"],
      "transformedParts": [{ "isVisible": false, "part": "miraidon_ride" }]
    },
    "fly": {
      "animations": [
        "q.look('head_ride', 0.4, 0.25, 5, -5, 10, -10)",
        "q.bedrock('miraidon_snowfated', 'air_fly')"
      ],
      "condition": "!q.is_gliding",
      "isBattle": false,
      "isTouchingWater": false,
      "poseTypes": ["FLY", "HOVER"],
      "quirks": ["q.bedrock_quirk('miraidon_snowfated', 'blink')"]
    },
    "glide": {
      "animations": [
        "q.look('head_ride', 0.4, 0.25, 5, -5, 10, -10)",
        "q.bedrock('miraidon_snowfated', 'air_fly')",
        "q.bedrock('miraidon_snowfated', 'air_dive')"
      ],
      "condition": "q.is_gliding",
      "isBattle": false,
      "isTouchingWater": false,
      "poseTypes": ["FLY"],
      "quirks": ["q.bedrock_quirk('miraidon_snowfated', 'blink')"]
    },
    "mount_idle": {
      "animations": [
        "q.look('head_ride')",
        "q.bedrock('miraidon_snowfated', 'ground_idle')"
      ],
      "condition": "q.is_ridden && !q.in_air",
      "isBattle": false,
      "isTouchingWater": false,
      "poseTypes": ["STAND"],
      "quirks": ["q.bedrock_quirk('miraidon_snowfated', 'blink')"],
      "transformedParts": [{ "isVisible": false, "part": "miraidon_battle" }]
    },
    "mount_run": {
      "animations": [
        "q.look('head_ride')",
        "q.bedrock('miraidon_snowfated', 'ride_ground_run')",
        "q.bedrock('miraidon_snowfated', 'ground_run')",
        {
          "animation": "q.bedrock('miraidon_snowfated', 'ride_mount_run')",
          "condition": "q.is_ridden"
        }
      ],
      "condition": "!q.in_air && q.is_sprinting && q.is_ridden && q.has_entity",
      "isBattle": false,
      "isTouchingWater": false,
      "poseTypes": ["WALK"],
      "quirks": ["q.bedrock_quirk('miraidon_snowfated', 'blink')"],
      "transformedParts": [{ "isVisible": false, "part": "miraidon_battle" }]
    },
    "mount_walk": {
      "animations": [
        "q.look('head_ride')",
        "q.bedrock('miraidon_snowfated', 'ride_mount_walk')",
        "q.bedrock('miraidon_snowfated', 'ground_walk')",
        {
          "animation": "q.bedrock('miraidon_snowfated', 'ride_mount_walk')",
          "condition": "q.is_ridden"
        }
      ],
      "condition": "q.is_ridden && !q.is_sprinting && !q.is_air && q.has_entity",
      "isBattle": false,
      "isTouchingWater": false,
      "poseTypes": ["WALK"],
      "quirks": ["q.bedrock_quirk('miraidon_snowfated', 'blink')"],
      "transformTicks": 5,
      "transformToTicks": 5,
      "transformedParts": [{ "isVisible": false, "part": "miraidon_battle" }]
    },
    "ride_jump": {
      "animations": [
        "q.look('head_ride')",
        "q.bedrock('miraidon_snowfated','ride_jump')",
        "q.bedrock('miraidon_snowfated', 'ride_mount_run')"
      ],
      "condition": "q.in_air && q.is_ridden && q.has_entity",
      "isBattle": false,
      "isTouchingWater": false,
      "poseTypes": ["WALK", "STAND", "NONE"],
      "quirks": ["q.bedrock_quirk('miraidon_snowfated', 'blink')"],
      "transformTicks": 5,
      "transformToTicks": 5,
      "transformedParts": [{ "isVisible": false, "part": "miraidon_battle" }]
    },
    "standing": {
      "animations": [
        "q.look('head_ride')",
        "q.bedrock('miraidon_snowfated', 'ground_idle')"
      ],
      "condition": "!q.is_ridden",
      "isBattle": false,
      "isTouchingWater": false,
      "poseTypes": ["STAND", "NONE", "PORTRAIT", "PROFILE"],
      "quirks": ["q.bedrock_quirk('miraidon_snowfated', 'blink')"],
      "transformedParts": [{ "isVisible": false, "part": "miraidon_battle" }]
    },
    "surface_idle": {
      "animations": [
        "q.look('head_ride')",
        "q.bedrock('miraidon_snowfated', 'water_idle')"
      ],
      "isTouchingWater": true,
      "isUnderWater": false,
      "poseTypes": ["STAND", "FLOAT"],
      "quirks": ["q.bedrock_quirk('miraidon_snowfated', 'blink')"],
      "transformedParts": [{ "part": "body_ride", "position": [0, 11, 0] }]
    },
    "surface_swim": {
      "animations": [
        "q.look('head_ride')",
        "q.bedrock('miraidon_snowfated', 'water_swim')"
      ],
      "isTouchingWater": true,
      "isUnderWater": false,
      "poseTypes": ["WALK", "SWIM"],
      "quirks": ["q.bedrock_quirk('miraidon_snowfated', 'blink')"],
      "transformedParts": [{ "part": "body_ride", "position": [0, 11, 0] }]
    },
    "walking": {
      "animations": [
        "q.look('head_ride')",
        "q.bedrock('miraidon_snowfated', 'ground_walk')"
      ],
      "condition": "!q.is_ridden",
      "isTouchingWater": false,
      "poseTypes": ["WALK"],
      "quirks": ["q.bedrock_quirk('miraidon_snowfated', 'blink')"],
      "transformedParts": [{ "isVisible": false, "part": "miraidon_battle" }]
    }
  },
  "profileScale": 0.64,
  "profileTranslation": [0.04, 0.86, -5],
  "rootBone": "miraidon_snowfated",
  "thirdPersonCameraOffset": {
    "seat_1": [0, 0.34, 0],
    "seat_1_reverse": [0, 0.34, 0]
  },
  "thirdPersonCameraOffsetNoViewBobbing": {
    "seat_1": [0, 0.34, 0],
    "seat_1_reverse": [0, 0.34, 0]
  }
}
